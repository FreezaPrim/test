# Copy to .env and adjust. Never commit the real .env file.

# development | test | production  (demo seeding is only allowed in development)
APP_ENV=development
APP_NAME=Shift Outage & Leave Portal

# SQLite file (relative paths are resolved from the project folder)
DATABASE_URL=sqlite:///data/app.db

# IANA timezone used for all input and display
APP_TIMEZONE=Africa/Cairo

# Sessions
SESSION_TIMEOUT_MINUTES=30
SESSION_MAX_HOURS=12

# Login protection
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# Business rules
MAX_OUTAGE_HOURS=24
OUTAGE_MAX_PAST_DAYS=30
MAX_LEAVE_DAYS=60
LEAVE_MAX_PAST_DAYS=30

# Evidence uploads (stored outside any web-served folder)
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=5
MAX_ATTACHMENTS_PER_SUBMISSION=3

# Exports
EXPORT_ROW_LIMIT=50000

# Logging
LOG_LEVEL=INFO
# LOG_FILE=logs/app.log
SQL_ECHO=false

# Only set to true when running behind a reverse proxy you control
# (makes the audit log use X-Forwarded-For for the client IP).
TRUST_PROXY_HEADERS=false

# Optional: non-interactive first admin creation (python manage.py create-admin).
# Remove these values after use.
# INITIAL_ADMIN_USERNAME=
# INITIAL_ADMIN_FULL_NAME=
# INITIAL_ADMIN_EMPLOYEE_ID=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
